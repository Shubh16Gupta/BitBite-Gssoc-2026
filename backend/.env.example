# ===========================================
# FarmTrust Backend — Environment Variables
# Copy this file to `.env` and fill in real values.
# ===========================================

# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/farmtrust

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# OTP
OTP_EXPIRY_MINUTES=5

# CORS (comma-separated list of allowed origins; * for all)
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100

# --- OTP / SMS delivery ---
# auto | fast2sms | msg91 | twilio | mock
#   auto  = use whichever credentials below are filled in
#   mock  = log the code to the server console (development only; the service
#           refuses to run in mock mode when NODE_ENV=production)
SMS_PROVIDER=auto
SMS_COUNTRY_CODE=+91
SMS_TIMEOUT_MS=10000

# Fast2SMS (fastest path to real delivery in India — one API key, their own
# DLT-approved OTP template). Get a key at https://www.fast2sms.com
FAST2SMS_API_KEY=

# MSG91 (needs your own DLT-registered OTP template id)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Twilio (global; Indian destinations still require a DLT-registered sender)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Initial admin seed (used by `npm run seed:admin`)
SEED_ADMIN_NAME=FarmTrust Admin
SEED_ADMIN_EMAIL=admin@farmtrust.in
SEED_ADMIN_PASSWORD=

# Public base URL of this backend (used for locally-stored upload URLs when
# Cloudinary is not configured). Change if the ML service runs on another host.
PUBLIC_BASE_URL=http://localhost:5000

# Cloudinary (Weekly Crop Analysis image storage) — leave blank to store uploads
# on local disk under /uploads instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=farmtrust/weekly-analysis
# Folder for farmer identity documents (Aadhaar front/back).
CLOUDINARY_DOCUMENTS_FOLDER=farmtrust/farmer-documents

# Weather API (defaults to free, key-less Open-Meteo)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_TIMEOUT_MS=5000

# Rainfall history lookback window (days) for the crop-cycle pipeline
RAINFALL_LOOKBACK_DAYS=30

# Crop-health ML service (see /ml-service). Leave URL blank to use the mock score.
# Point this at the running FastAPI service; the backend calls `${URL}/analyze`.
AI_SERVICE_URL=
AI_SERVICE_TIMEOUT_MS=20000
AI_SERVICE_MOCK_SCORE=87
AI_SAMPLE_COUNT=10

# Weight of weather in the final AnnScore blend (0..1).
# annScore = (1 - weight) * cropHealthScore + weight * weatherScore
SCORE_WEATHER_WEIGHT=0.2

# Market prices (data.gov.in / Agmarknet). Default key is data.gov.in's public
# sample key; get your own free key at https://data.gov.in for higher limits.
MARKET_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b
MARKET_API_TIMEOUT_MS=8000
